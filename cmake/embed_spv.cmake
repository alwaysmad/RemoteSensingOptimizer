# cmake/embed_spv.cmake
# Embeds SPIR-V binary as C++ header with constexpr array
# 
# Expected defines:
#   INPUT_FILE  - Path to .spv binary file
#   OUTPUT_FILE - Path to output .hpp file
#   NAMESPACE   - C++ namespace for generated code

# 1. Read the SPIR-V binary as a hex string
file(READ "${INPUT_FILE}" HEX_CONTENT HEX)

# 2. Format it as 32-bit integers (0x07230203, ...)
#    We capture 4 bytes (8 hex chars) at a time: (..)(..)(..)(..)
#    And rewrite them in reverse order for Little Endian: 0x\4\3\2\1
string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1, " HEX_FORMATTED "${HEX_CONTENT}")

# 3. Write the C++ header
file(WRITE "${OUTPUT_FILE}" "// Generated by embed_spv.cmake\n")

file(APPEND "${OUTPUT_FILE}" "#pragma once\n")
file(APPEND "${OUTPUT_FILE}" "namespace ${NAMESPACE} \n{\n")
file(APPEND "${OUTPUT_FILE}" "static constexpr uint32_t code[] = { ${HEX_FORMATTED} };\n")

# Generate the CreateInfo struct
file(APPEND "${OUTPUT_FILE}" "	constexpr vk::ShaderModuleCreateInfo smci\n")
file(APPEND "${OUTPUT_FILE}" "	{\n")
file(APPEND "${OUTPUT_FILE}" "		.flags = {},\n")
file(APPEND "${OUTPUT_FILE}" "		.codeSize = sizeof(code),\n")
file(APPEND "${OUTPUT_FILE}" "		.pCode = code\n")
file(APPEND "${OUTPUT_FILE}" "	};\n")

file(APPEND "${OUTPUT_FILE}" "} // namespace ${NAMESPACE}\n")
